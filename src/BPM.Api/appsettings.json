{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=bpm;Username=bpm;Password=bpm"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "bpm-platform",
    "Audience": "bpm-platform",
    "ExpiryMinutes": 60
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "bpm",
    "SecretKey": "bpm12345",
    "BucketName": "bpm-attachments",
    "UseSsl": false
  },
  "Email": {
    "Enabled": false,
    "Provider": "Fake",
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "UseSsl": true,
    "FromAddress": "bpm-platform@example.com",
    "FromName": "BPM Platform",
    "PollIntervalSeconds": 15,
    "BatchSize": 20,
    "MaxAttempts": 5,
    "RetryBackoffSeconds": 30,
    "StaleClaimTimeoutSeconds": 300
  },
  "SlaScheduler": {
    "Enabled": true,
    "PollIntervalSeconds": 60,
    "BatchSize": 50
  },
  "Dashboard": {
    "DueSoonHours": 24
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/bpm-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  }
}
